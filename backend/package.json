{
  "name": "hospital-lab-backend",
  "version": "1.0.0",
  "description": "Hospital Management System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seedUsers.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node migrate.js up",
    "migrate:status": "node migrate.js status",
    "seed:demo": "node seed_demo_data.js",
    "typecheck": "tsc --noEmit && tsc --project ../frontend/tsconfig.contracts.json",
    "contracts:generate": "node scripts/generateClinicalContracts.cts",
    "contracts:check": "node scripts/generateClinicalContracts.cts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "nodemon": "^3.0.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
