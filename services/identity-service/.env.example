NODE_ENV=development
PORT=5101
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_NAME=hms
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=replace_with_the_same_secret_used_by_the_gateway
JWT_EXPIRES_IN=8h
INTERNAL_SERVICE_SECRET=replace_with_at_least_32_random_characters
MONOLITH_URL=http://127.0.0.1:5002
EXPOSE_RESET_OTP=false
REQUEST_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
