    {
      "type": "bargauge",
      "title": "Beds by ward (% full)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hms-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hms-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ward, ROUND(100.0 * occupied / NULLIF(total, 0)) AS \"% full\" FROM (SELECT COALESCE(w.name, 'No ward') AS ward, COUNT(*) FILTER (WHERE b.status = 'Occupied') AS occupied, COUNT(*) AS total FROM hms_beds b LEFT JOIN hms_wards w ON w.id = b.ward_id WHERE b.is_active = 1 GROUP BY 1 ORDER BY 1) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
