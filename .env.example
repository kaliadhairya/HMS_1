# Copy to .env (never commit .env). Docker Compose reads it automatically.
# Generate secrets with:  openssl rand -hex 32

# Required. Signs login sessions; the backend refuses to start without a
# private value of at least 32 characters.
JWT_SECRET=

# Production compose only.
DB_PASSWORD=
# Must equal the key existing Aadhaar data was encrypted with, or that data
# can no longer be read.
AADHAAR_ENCRYPTION_KEY=

# Data keyring for personal data and documents (A4): id:64-hex pairs,
# comma-separated; the first encrypts new values (openssl rand -hex 32).
# To rotate, put a new key first, keep the old one listed, run
# "node scripts/rekey-data.js", then remove the old key.
HMS_DATA_KEYS=
# Private, encrypted patient documents (not under uploads/).
HMS_DOCUMENT_DIR=
# Service account approved for background work (downtime kits, finance
# checks). Give it a current membership of each facility; with the
# production database identity, row policies hide facility records from
# background work without it.
HMS_WORKER_USER_ID=

# Signs audit checkpoints (openssl rand -hex 32). Keep a copy outside the
# server: it is needed to verify them (backend/scripts/audit-verify.js).
AUDIT_CHECKPOINT_KEY=

# Leave empty unless an external Identity Service is deployed.
INTERNAL_SERVICE_SECRET=
