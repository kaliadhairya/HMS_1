# Copy to .env (never commit .env). Docker Compose reads it automatically.
# Generate secrets with:  openssl rand -hex 32

# Required. Signs login sessions; the backend refuses to start without a
# private value of at least 32 characters.
JWT_SECRET=

# Production compose only.
DB_PASSWORD=
# Must equal the key existing Aadhaar data was encrypted with, or that data
# can no longer be read.
AADHAAR_ENCRYPTION_KEY=

# Leave empty unless an external Identity Service is deployed.
INTERNAL_SERVICE_SECRET=
